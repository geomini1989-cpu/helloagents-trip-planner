# LLM configuration
LLM_MODEL_ID=qwen-plus
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT=120

# Agent reliability
# 2 means: after the first failed attempt, retry at most 2 more times.
AGENT_MAX_RETRIES=2
AGENT_RETRY_BACKOFF_SECONDS=0.5

# Server configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Optional image service
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
UNSPLASH_SECRET_KEY=your_unsplash_secret_key_here

# AMap Web Service API key (not the frontend Web/JS API key)
AMAP_API_KEY=your_amap_web_service_api_key_here
AMAP_ROUTE_TIMEOUT_SECONDS=8

# Optional independent web-search source for Local Knowledge Agent
# Without this key, Local Knowledge explicitly degrades and never fabricates opening/reservation rules.
TAVILY_API_KEY=your_tavily_api_key_here
LOCAL_KNOWLEDGE_MAX_RESULTS=5
LOCAL_KNOWLEDGE_TIMEOUT_SECONDS=12
